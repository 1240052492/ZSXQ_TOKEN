# ============================================
# ZSXQ Token Integration - Production
# ============================================
# Generated: 2026-09-29
# Environment: production
# ============================================

# Node Environment
NODE_ENV=production
LOG_LEVEL=info

# ============================================
# Docker Image Configuration
# ============================================
GITHUB_REPOSITORY=your-org/zsxq-token
IMAGE_TAG=latest

# ============================================
# Service Ports
# ============================================
PLATFORM_GATEWAY_PORT=3000
SUPER_CANVAS_ADAPTER_PORT=3001
OPC_SERVICE_PORT=3002

# ============================================
# Database Root Credentials
# ============================================
POSTGRES_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# Internal Service Authentication (64+ chars)
# ============================================
SERVICE_TOKEN_SECRET=CHANGE_ME_IN_PRODUCTION

# ============================================
# JWT & Session Secrets (32+ chars)
# ============================================
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION

# ============================================
# OPC Internal Authentication (32+ chars)
# ============================================
OPC_SSO_INTERNAL_TOKEN=CHANGE_ME_IN_PRODUCTION

# ============================================
# Database - New API
# ============================================
NEW_API_DB_NAME=new_api
NEW_API_DB_USER=zsxq_new_api_runtime
NEW_API_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# Database - OPC Core
# ============================================
OPC_DB_NAME=opc_core
OPC_DB_USER=zsxq_opc_core_runtime
OPC_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# Database - Super Canvas
# ============================================
CANVAS_DB_NAME=super_canvas
CANVAS_DB_USER=zsxq_super_canvas_runtime
CANVAS_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# Redis (Optional)
# ============================================
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# Object Storage (Optional - S3 Compatible)
# ============================================
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=zsxq-storage
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# ============================================
# API Timeouts (milliseconds)
# ============================================
API_TIMEOUT=30000
PROXY_TIMEOUT=120000

# ============================================
# Security - CORS Origins
# ============================================
CORS_ORIGINS=https://yourdomain.com
